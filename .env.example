# Copy this file to .env for local server configuration. Never commit .env.
NODE_ENV=development
YASPRETTY_HOST=127.0.0.1
FISHTALK_PORT=8787

# Server-only Zhipu configuration. Leave the example value empty.
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_SEARCH_ENGINE=search_std
ZHIPU_MAX_TOKENS=4096

# Upstream timeout, per-minute limits, and in-memory daily AI quota.
UPSTREAM_TIMEOUT_MS=20000
API_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_MAX=20
AI_DAILY_LIMIT=200

# Enable only when deployed behind a trusted reverse proxy.
TRUST_PROXY=false
