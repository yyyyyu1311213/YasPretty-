{
  "name": "yaspretty-beauty-catalog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,AI \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"node server/fishtalk-server.cjs --no-open\"",
    "dev:web": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:ai": "node server/fishtalk-server.cjs --no-open",
    "sync:verification": "node scripts/sync-product-verification.mjs",
    "build": "vite build",
    "start": "node server/fishtalk-server.cjs --no-open",
    "preview": "node server/fishtalk-server.cjs --no-open",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "lucide-react": "latest",
    "ogl": "^1.0.11",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
